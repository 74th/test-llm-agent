# Application key: only the host-side controller reads this.
OPENAI_API_KEY=

# Restricted environment key: the controller passes it to the executor as
# CODEX_API_KEY at runtime. Never commit the value or put it in an image.
OPENAI_EXECUTOR_API_KEY=

# Use a model enabled for the project and the Agents API.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EXECUTOR_IMAGE=self-hosted-session-verifier:local
OPENAI_WORKSPACE_DIRECTORY=/workspace
# Comma-separated absolute plugin roots inside the executor container.
OPENAI_CAPABILITY_DIRECTORIES=/workspace/capabilities/plugins/config-probe
# Agent-wide policy, supplied as agent.instructions when a new session is created.
OPENAI_AGENT_INSTRUCTIONS=Use the workspace instructions and relevant skills. Answer in Japanese.
SELF_HOSTED_STATE_DIR=state
SELF_HOSTED_LOG_DIR=logs
SELF_HOSTED_REPORT_DIR=reports

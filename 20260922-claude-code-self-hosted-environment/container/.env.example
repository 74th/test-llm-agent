# Copy this file to container/.env and fill in real values.
# container/.env is git-ignored — never commit it.

# Pinned Claude Code version to build into the image (see README.md for how
# to check the latest known-good version).
CLAUDE_CODE_VERSION=2.1.278

# Built image tag; leave as-is unless you push to a registry.
RUNNER_IMAGE=claude-self-hosted-runner:verify

# GitHub PAT for the GitHub MCP server (task 1.4). Never commit this value.
GITHUB_PAT=

# Path to the one-time environment secret file copied from the claude.ai
# admin UI (task 1.2). Must exist on the host before `docker compose up`.
ENVIRONMENT_SECRET_FILE=../secrets/environment-secret

# Path to the GCP service account key issued by `gcloud iam
# service-accounts keys create` (task 1.8). Must exist on the host, mode
# 0600, outside the repository. MUST be an absolute path: Mode B
# (compose.ondemand.yaml) passes this value through to `docker run` on the
# host's Docker daemon via the mounted docker.sock, which resolves bind-mount
# sources against the host filesystem, not any container's filesystem.
GCP_SA_KEY_PATH=/absolute/path/to/secrets/gcp-sa.json

# Host directory for the shared JSONL event log (task 7.x). Created
# automatically if it doesn't exist. MUST also be an absolute path — same
# docker-outside-of-docker reason as GCP_SA_KEY_PATH above.
CCR_EVENT_LOG_DIR=/absolute/path/to/events

# Host path to workspace/ (skills, hooks, settings.json seeded into every
# session). Mode B's spawned session containers are created through the
# host's docker.sock (docker-outside-of-docker), so this MUST be an absolute
# path — same reason as GCP_SA_KEY_PATH/CCR_EVENT_LOG_DIR above.
WORKSPACE_DIR=/absolute/path/to/workspace
